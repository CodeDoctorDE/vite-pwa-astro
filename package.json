{
  "name": "@vite-pwa/astro",
  "type": "module",
  "version": "1.2.0",
  "packageManager": "pnpm@12.10.1",
  "description": "Zero-config PWA for Astro",
  "author": "antfu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://github.com/CodeDoctorDE/vite-pwa-astro#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodeDoctorDE/vite-pwa-astro.git"
  },
